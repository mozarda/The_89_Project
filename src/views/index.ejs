<%- include('partials/header', { title: 'Beranda' }) %>

  <section class="hero">
    <div class="hero-content">
      <h1 class="calligraphy-text">
        يَا أَيُّهَا الَّذِينَ آمَنُوا</h1>
      <p class="tagline">Menyahut Panggilan Iman, Menata Hati Memetik Hikmah</p>
    </div>
  </section>

  <section class="posts-list">
    <% if (posts.length===0) { %>
      <div class="no-posts">
        <p>Perjalanan baru dimulai. Belum ada tulisan saat ini.</p>
      </div>
      <% } else { %>
        <% posts.forEach(post=> { %>
          <article class="post-card">
            <div class="post-meta">
              <span>📅 <%= new Date(post.date).toLocaleDateString('id-ID', { year: 'numeric' , month: 'long' ,
                  day: 'numeric' }) %></span>
            </div>
            <h2><a href="/post/<%= post.slug %>">
                <%= post.title %>
              </a></h2>
            <p class="post-excerpt">
              <%= post.excerpt %>
            </p>
            <a href="/post/<%= post.slug %>" class="read-more">Baca Selengkapnya <span>→</span></a>
          </article>
          <% }) %>
            <% } %>
  </section>

  <%- include('partials/footer') %>