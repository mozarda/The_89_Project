<%- include('partials/header', { title: 'Home' }) %>

<section class="hero">
  <div class="container">
    <h1>Welcome</h1>
    <p class="tagline">Ya ayyuhalladhina amanu - O you who believe</p>
  </div>
</section>

<section class="posts-list">
  <div class="container">
    <% if (posts.length === 0) { %>
      <p class="no-posts">No posts yet. <a href="/admin">Create one</a>!</p>
    <% } else { %>
      <% posts.forEach(post => { %>
        <article class="post-card">
          <h2><a href="/post/<%= post.slug %>"><%= post.title %></a></h2>
          <p class="post-date"><%= new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
          <p class="post-excerpt"><%= post.excerpt %></p>
          <a href="/post/<%= post.slug %>" class="read-more">Read more →</a>
        </article>
      <% }) %>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
