<%- include('partials/header', { title: 'Admin' }) %>

<section class="admin-section">
  <div class="container">
    <h1>Admin Panel (Read-Only)</h1>
    <p class="admin-note">
      This is a static build. To add/edit posts, edit <code>data/posts.json</code> in the repository and rebuild.
      <br>
      Command: <code>npm run build</code> then push to trigger Cloudflare Pages deploy.
    </p>

    <div class="admin-posts">
      <h2>All Posts (<%= posts.length %>)</h2>
      <% if (posts.length === 0) { %>
        <p>No posts yet. Add entries to data/posts.json.</p>
      <% } else { %>
        <table class="posts-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Slug</th>
              <th>Date</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(post => { %>
              <tr>
                <td><a href="/post/<%= post.slug %>" target="_blank"><%= post.title %></a></td>
                <td><code><%= post.slug %></code></td>
                <td><%= new Date(post.date).toLocaleDateString() %></td>
                <td><%= post.published ? '✅ Published' : '⚪ Draft' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
