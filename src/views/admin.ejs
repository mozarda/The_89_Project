<%- include('partials/header', { title: 'Admin Panel' }) %>

<section class="admin-section">
  <div class="container">
    <h1>Admin Panel</h1>
    <p class="admin-intro">This is a read-only listing of all posts. To edit, modify <code>data/posts.json</code> and run <code>npm run build</code>.</p>
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Title</th>
          <th>Slug</th>
          <th>Date</th>
          <th>Published</th>
        </tr>
      </thead>
      <tbody>
        <% posts.forEach(post => { %>
          <tr>
            <td><%= post.id %></td>
            <td><%= post.title %></td>
            <td><code><%= post.slug %></code></td>
            <td><%= new Date(post.date).toLocaleDateString('id-ID') %></td>
            <td><%= post.published ? '✅' : '❌' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/footer') %>
